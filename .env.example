# Copy this file to .env for local development and fill in the values.

# Application HTTP port inside container/process (used to build ASPNETCORE_URLS when not set explicitly).
APP_PORT=

# Platform-provided port fallback used when APP_PORT is not set.
PORT=

# Optional explicit ASP.NET Core binding. When set, this overrides APP_PORT/PORT-derived binding.
ASPNETCORE_URLS=

# Optional host port mapping for docker compose deployments.
HOST_PORT=

# PostgreSQL connection used by AppDbContext.
DATABASE_CONNECTION_STRING=

# Redis cache connection and default cache behavior.
REDIS_CONNECTION_STRING=
CACHE_KEY_PREFIX=
CACHE_DEFAULT_ABSOLUTE_EXPIRATION_SECONDS=

# RabbitMQ connection, publishing exchange and consumer queue. Queue bindings are set up manually.
RABBITMQ_URI=
RABBITMQ_QUEUE=
RABBITMQ_EXCHANGE=
# App slug used as both source and tenant of published events (routing key <slug>.<slug>.<action>).
APP_EVENT_SOURCE=

# Glitchtip/Sentry-compatible error and log reporting. Leave GLITCHTIP_DSN empty to disable; GLITCHTIP_RELEASE is required when it is set.
GLITCHTIP_DSN=
GLITCHTIP_RELEASE=

# API rate limiting.
RATE_LIMIT_PERMIT_LIMIT=
RATE_LIMIT_WINDOW_SECONDS=
RATE_LIMIT_QUEUE_LIMIT=

# Keycloak authentication.
KEYCLOAK_AUTHORITY=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
